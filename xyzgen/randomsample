import argparse, os
import numpy as np

def _rattle(samples, sels, rs, amplitude):
    """Add Gaussian noise of width `amplitude` (ang) to the selected frames."""
    if amplitude is None:
        return
    for sel in sels:
        rand = rs.randn(samples[sel].positions.shape[0], samples[sel].positions.shape[1]) * amplitude
        samples[sel].positions += rand

def _normalize(desc):
    """Scale every frame descriptor to unit L2 norm.

    Unnormalized SOAP vectors have a magnitude that tracks the overall
    atomic density, so raw euclidean distances between frames are dominated
    by density and composition rather than by structural differences. For a
    fixed-composition, fixed-cell MD run that magnitude is nearly constant
    and normalizing changes little, but as soon as several files with
    differing composition or volume are pooled together it is what keeps FPS
    selecting on structure. On unit vectors the distance used here is the
    usual chordal distance of the normalized SOAP kernel,
    sqrt(2 - 2*cos), bounded in [0, 2]. Zero rows are left untouched.
    """
    norms = np.linalg.norm(desc, axis=1, keepdims=True)
    return desc / np.where(norms > 0, norms, 1.0)

def _greedy_fps(desc, n, rs):
    """Greedy max-min farthest point sampling over an (n_frames, n_features) array.

    Starting from one random frame, repeatedly adds the frame whose distance
    to its nearest already-selected neighbor is largest. `min_dist` caches
    that nearest-selected distance for every frame, so each step costs one
    pass over the descriptors instead of a full pairwise recompute. Selected
    frames are parked at -1 (below any real distance, which is >= 0) so they
    can never be picked again, even when duplicate frames make the largest
    remaining distance 0.

    Returns indices in selection order, referring to the order of `desc`.
    """
    first = rs.randint(len(desc))
    sels = [first]
    min_dist = np.linalg.norm(desc - desc[first], axis=1)
    min_dist[first] = -1
    for _ in range(n - 1):
        nxt = int(np.argmax(min_dist))
        sels.append(nxt)
        min_dist = np.minimum(min_dist, np.linalg.norm(desc - desc[nxt], axis=1))
        min_dist[nxt] = -1
    return np.array(sels)

def soap_descriptors(samples, rcut=5.0, nmax=8, lmax=6, sigma=0.5, normalize=True):
    """One averaged SOAP vector per frame, shape (n_frames, n_features)."""
    from dscribe.descriptors import SOAP
    species = sorted(set(samples[0].get_chemical_symbols()))
    periodic = bool(samples[0].pbc.any())
    soap = SOAP(species=species, r_cut=rcut, n_max=nmax, l_max=lmax, sigma=sigma,
                periodic=periodic, average="inner")
    desc = soap.create(samples)
    return _normalize(desc) if normalize else desc

def random_sample(samples, n, seed=None, amplitude=None):
    if seed is None:
        from time import time
        seed = int(time())
    rs = np.random.RandomState(seed)
    rs.shuffle(samples)
    sels = rs.choice(np.arange(0, len(samples)), n, replace=False) ## ful random
    _rattle(samples, sels, rs, amplitude)
    return sels, seed

def fps_sample(samples, n, seed=None, amplitude=None, rcut=5.0, nmax=8, lmax=6,
               sigma=0.5, normalize=True):
    """Farthest point sampling over per-frame SOAP descriptors.

    Greedily grows a diverse subset by always adding the frame whose
    distance to its nearest already-selected neighbor is largest, so the
    result covers configuration space instead of just the trajectory
    order. Unlike random_sample, indices are returned in selection order
    and refer to the original (unshuffled) frame ordering.
    """
    if len(samples) < n:
        raise ValueError(f"--samples ({n}) exceeds number of available frames ({len(samples)})")
    if seed is None:
        from time import time
        seed = int(time())
    rs = np.random.RandomState(seed)

    desc = soap_descriptors(samples, rcut=rcut, nmax=nmax, lmax=lmax, sigma=sigma,
                            normalize=normalize)
    sels = _greedy_fps(desc, n, rs)
    _rattle(samples, sels, rs, amplitude)
    return sels, seed

def main():
    parser = argparse.ArgumentParser(
            prog='mdsampler',
            description="""
            Sample geometries from an ASE-readable MD trajectory.
            Supports plain random sampling and diversity-based
            farthest point sampling (FPS) over SOAP descriptors.
            """)
    parser.add_argument("--samples", "-n", type=int,
                        help="Number of structures to extract from MD simulation",
                        required=True)

    parser.add_argument("--path", "-i", nargs="+", required=True,
                        help="Path to XYZ file that contains MD simulation")

    parser.add_argument("--outfolder", "-o", required=False, default="sample",
                        type=str, help="name-03d for sampled geometries")

    parser.add_argument("--format", "-f", required=False, default="aims",
                        help="Output formart from ASE for the writen geometries")

    parser.add_argument("--amplitude", required=False, default=None, type=float,
                        help="Random amplitude in for additional rattle. Amplitude in Angstrom")

    parser.add_argument("--seed", required=False, default=None, type=int,
                        help="Seed for the random generator default")

    parser.add_argument("--method", required=False, default="random",
                        choices=["random", "fps"],
                        help="Selection method: 'random' (default, uniform "
                             "random without replacement) or 'fps' (farthest "
                             "point sampling over SOAP descriptors, for a "
                             "diverse/non-redundant subset)")

    parser.add_argument("--no-normalize", dest="normalize", action="store_false",
                        help="Do not L2-normalize the frame descriptors before FPS. "
                             "Normalization is on by default so distances measure "
                             "structural difference rather than descriptor magnitude "
                             "(only used with --method fps)")

    parser.add_argument("--soap-rcut", required=False, default=5.0, type=float,
                        help="SOAP cutoff radius in Angstrom (only used with --method fps)")

    parser.add_argument("--soap-nmax", required=False, default=8, type=int,
                        help="SOAP n_max (only used with --method fps)")

    parser.add_argument("--soap-lmax", required=False, default=6, type=int,
                        help="SOAP l_max (only used with --method fps)")

    parser.add_argument("--soap-sigma", required=False, default=0.5, type=float,
                        help="SOAP Gaussian width sigma (only used with --method fps)")

    args = parser.parse_args()

    from ase.io import read, write

    samples = []
    for f in args.path:
        for s in read(f, ":"):
            samples.append(s)
    addrand = args.amplitude is not None
    if addrand:
        print('Random amplitude: ', args.amplitude, ' (ang)')

    if args.method == "random":
        sels, args.seed = random_sample(samples, args.samples, seed=args.seed, amplitude=args.amplitude)
    else:
        sels, args.seed = fps_sample(samples, args.samples, seed=args.seed, amplitude=args.amplitude,
                                      rcut=args.soap_rcut, nmax=args.soap_nmax,
                                      lmax=args.soap_lmax, sigma=args.soap_sigma,
                                      normalize=args.normalize)

    print(f'Removing {args.outfolder}*/')
    print('Using seed: ', args.seed)
    os.system(f'rm -r {args.outfolder}*/ 2>/dev/null')
    cc = 0
    for sel in sels:
        path = f'{args.outfolder}-{cc:03d}'
        os.mkdir(path)
        write(f'{path}/{path}.in', samples[sel],format=args.format)
        os.system(f"sed -i -e '3s/^$/# Seed: {args.seed} Snapshot: {sel} Amplitude: {args.amplitude} (ang)/' {path}/{path}.in")
        cc+=1

if __name__ == "__main__":
    main()
